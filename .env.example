# Set in your shell or $HOME/.config/budai/environment for the optional user service.
# All model services stay on the computer running BudAI.
BUDAI_OLLAMA_URL=http://127.0.0.1:11434
BUDAI_COMFYUI_URL=http://127.0.0.1:8188
# BUDAI_DATA_DIR=/home/you/.local/share/budai
# BUDAI_ORIGIN=https://budai.example.internal
# BUDAI_CHROMIUM=/usr/bin/chromium
# BUDAI_WHISPER_MODEL=/home/you/.local/share/whisper.cpp/ggml-base.en.bin
# BUDAI_EMBEDDING_MODEL=your-installed-embedding-model
# BUDAI_SHERPA_MODEL=/home/you/.local/share/budai/voice/sherpa-onnx-whisper-tiny.en
